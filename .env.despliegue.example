# Variables que lee compose.prod.yaml en el servidor.
#
# Se copia a `.env` en la raíz del proyecto, junto al compose. El mismo archivo
# sirve para el entorno de prueba y para producción: lo único que cambia es
# URL_SITIO y las credenciales.
#
#   cp .env.despliegue.example .env && nano .env

# ─── Entorno ─────────────────────────────────────────────────────────────────
# Nombre del despliegue. De él salen los nombres de los contenedores, de las
# imágenes y de los volúmenes, así que el entorno de prueba y el de producción
# no se pisan si conviven en la misma máquina.
PROYECTO=cirsubpage-stg

# Puertos en la interfaz local, los que va a buscar nginx. Si después convive
# con producción en el mismo servidor, ese usa otros.
PUERTO_API=3400
PUERTO_WEB=4400

# ─── Dominio ─────────────────────────────────────────────────────────────────
# Sin barra al final. De acá salen la URL de la API (/api) y la de los medios
# (/medios), que viven en el mismo dominio.
URL_SITIO=https://testpage.cirsubgn.org.ar

# Que los buscadores indexen el sitio. Dejalo en false mientras sea un entorno
# de prueba: si Google llega a indexar testpage, ese duplicado compite en las
# búsquedas contra el dominio que de verdad interesa posicionar. Ponelo en true
# recién cuando esto viva en el dominio definitivo.
SITIO_INDEXABLE=false

# ─── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=cirsub
POSTGRES_DB=cirsub
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── Sesión ──────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=

# ─── Correo (Google Workspace) ───────────────────────────────────────────────
# La casilla necesita verificación en dos pasos y una contraseña de aplicación:
# la contraseña normal de la cuenta no sirve para SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=noreply@cirsubgn.org
SMTP_PASSWORD=
SMTP_REMITENTE=CIRSUB <noreply@cirsubgn.org>
SMTP_RESPONDER_A=secretaria@cirsubgn.org

# ─── Superadministrador ──────────────────────────────────────────────────────
# Sólo se usa en la carga inicial. Sin contraseña el usuario no se crea.
# Conviene cambiarla desde el panel después del primer ingreso.
SUPERADMIN_EMAIL=admin@cirsubgn.org
SUPERADMIN_NOMBRE=Superadministrador
SUPERADMIN_PASSWORD=
