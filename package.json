{
  "name": "cirsub",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio institucional y panel de administración de la Mutual del Círculo de Suboficiales de Gendarmería Nacional",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:shared": "npm run build --workspace @cirsub/shared",
    "dev:web": "npm run start --workspace @cirsub/web",
    "dev:api": "npm run start:dev --workspace @cirsub/api",
    "build:web": "npm run build --workspace @cirsub/web",
    "build:api": "npm run build --workspace @cirsub/api",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "db:generate": "npm run prisma:generate --workspace @cirsub/api",
    "db:migrate": "npm run prisma:migrate --workspace @cirsub/api",
    "db:seed": "npm run prisma:seed --workspace @cirsub/api",
    "db:studio": "npm run prisma:studio --workspace @cirsub/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
