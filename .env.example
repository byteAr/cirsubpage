# ─── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=cirsub
POSTGRES_PASSWORD=cambiar_en_produccion
POSTGRES_DB=cirsub
DATABASE_URL=postgresql://cirsub:cambiar_en_produccion@localhost:5434/cirsub?schema=public

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3400
URL_SITIO=http://localhost:4200
URL_API=http://localhost:3400
URL_MEDIOS=http://localhost:3400/media
ORIGENES_PERMITIDOS=http://localhost:4200,http://localhost:4300
# Saltos de proxy inverso adelante. En el Debian, detrás de nginx, es 1.
PROXIES_CONFIABLES=1

# ─── Sesión ──────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
JWT_ACCESO_SEGUNDOS=900
JWT_REFRESCO_DIAS=7
COOKIE_REFRESCO=cirsub_rt
# En producción: .cirsubgn.org.ar
# COOKIE_DOMINIO=

# ─── Seguridad ───────────────────────────────────────────────────────────────
INVITACION_HORAS=72
RESET_MINUTOS=60
MAX_INTENTOS_INGRESO=5
BLOQUEO_MINUTOS=15

# ─── Archivos ────────────────────────────────────────────────────────────────
STORAGE_RAIZ=./storage
MAX_BYTES_ARCHIVO=15728640
CUOTA_FILIAL_BYTES=2147483648

# ─── Correo (Google Workspace) ───────────────────────────────────────────────
# La casilla necesita verificación en dos pasos y una contraseña de aplicación.
CORREO_HABILITADO=false
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_SEGURO=false
SMTP_USUARIO=noreply@cirsubgn.org
SMTP_PASSWORD=
SMTP_REMITENTE=CIRSUB <noreply@cirsubgn.org>
SMTP_RESPONDER_A=secretaria@cirsubgn.org

# ─── Semilla ─────────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@cirsubgn.org
SUPERADMIN_NOMBRE=Superadministrador
SUPERADMIN_PASSWORD=
